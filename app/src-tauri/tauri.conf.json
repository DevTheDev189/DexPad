{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nimbus Cosmic Bridge",
  "version": "0.1.0",
  "identifier": "com.nimbus.cosmicbridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Nimbus+ Cosmic Bridge",
        "width": 1200,
        "height": 800,
        "minWidth": 1120,
        "minHeight": 740,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
