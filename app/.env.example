# DexPad - Environment Variables
# Copy this file to .env and insert your API key:
# VITE_RAWG_API_KEY=your_api_key_here

# RAWG Video Games Database API Key (Get a free key at https://rawg.io/apidocs)
# When provided, game searches automatically query RAWG for comprehensive box art,
# descriptions, and metadata across non-Steam, Mac, and emulator titles.
VITE_RAWG_API_KEY=
